DATA_DIR=./data

# Select which LLM provider to use.
# If unset, the first provider with a key set is used automatically.
# Options: openai | openrouter | gemini | grok | groq
LLM_PROVIDER=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-8b-instruct:free

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# xAI Grok
XAI_API_KEY=
GROK_MODEL=grok-3-mini

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
